# Database configuration
DATABASE_URL=sqlite:///./disaster_coordinator.db
INGESTION_SERVICE_DB_URL=sqlite:///./ingestion.db
DISPATCH_SERVICE_DB_URL=sqlite:///./dispatch.db

# Security & Constraints
RATE_LIMIT_PER_MINUTE=10
SOLVER_TIMEOUT_SECONDS=5
MAX_EVALUATION_RETRIES=2

# Note: LLM API keys and endpoints are handled via model_router.py for local LM Studio integration.
# If migrating to cloud APIs, uncomment below:
# LLM_API_KEY=
# EMBEDDING_API_KEY=
